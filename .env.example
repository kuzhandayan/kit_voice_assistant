# --- App ---
APP_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Kolkata

# --- Provided college system ---
COLLEGE_API_BASE_URL=https://ht.knowvally.com
COLLEGE_PARTICIPANT_KEY=
COLLEGE_API_TIMEOUT_SECONDS=8
DOCUMENTS_REFRESH_SECONDS=300

# --- Storage ---
# Bare uvicorn: SQLite. docker compose overrides this with its own Postgres.
# Production: Supabase -> postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite:///./kit.db

# --- LLM chain, tried in order: vendor:model[@reasoning_effort] ---
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_CHAIN=groq:openai/gpt-oss-120b@low,gemini:gemini-3.5-flash@low,groq:openai/gpt-oss-20b@low,groq:qwen/qwen3.8-27b@none,gemini:gemini-3.1-flash-lite@low
LLM_TIMEOUT_SECONDS=20

# --- Speech-to-text chain: Groq Whisper -> Deepgram ---
GROQ_STT_MODEL=whisper-large-v3-turbo
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# --- Text-to-speech chain: Edge TTS -> Deepgram Aura ---
EDGE_TTS_VOICE=en-IN-NeerjaNeural
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# --- Limits ---
MAX_AUDIO_MB=5
MAX_AGENT_STEPS=6
RATE_LIMIT_PER_MINUTE=30
